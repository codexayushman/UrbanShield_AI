# UrbanShield AI — Environment Variables

# Supabase (pre-populated in hosted environment — do NOT commit real values)
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_DB_URL=your_supabase_db_connection_string

# Netlify
NETLIFY_AUTH_TOKEN=your_netlify_auth_token

# Note:
# - VITE_ prefixed vars are exposed to the frontend (client-side).
# - Non-prefixed vars are server-only (Netlify Functions).
# - NEVER expose SUPABASE_SERVICE_ROLE_KEY in frontend code.
# - The app works in demo mode without these — sample data is used instead.
